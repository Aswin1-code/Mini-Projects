# -------------------------------
def add_features(df):
    df["power"] =3D df["speed"] * df["impact"]
    df["efficiency"] =3D df["impact"] / (df["duration"] + 1e-6)
    df["intensity"] =3D (df["speed"] + df["impact"] + df["power"]) / 3
    return df


# -------------------------------
# CONSISTENCY / STABILITY SCORE
# -------------------------------
def stability_score(df):
    return 100 - (df["power"].std() / (df["power"].mean() + 1e-6)) * 100


# -------------------------------
# BEST STREAK
# -------------------------------
def best_streak(df):
    streak =3D best =3D 0
    for p in df["prediction"]:
        if p =3D=3D "STRONG":
            streak +=3D 1
            best =3D max(best, streak)
        else:
            streak =3D 0
    return best


# -------------------------------
# FEEDBACK ENGINE
# -------------------------------
def generate_feedback(df):
    feedback =3D []

    if df["power"].std() &gt; df["power"].mean() * 0.5:
        feedback.append("=E2=9A=A0=EF=B8=8F Power improving but inconsisten=
t")

    if df["speed"].mean() &gt; 45 and df["efficiency"].mean() &lt; 60:
        feedback.append("=E2=9A=A0=EF=B8=8F High speed but low impact effic=
iency =E2=86=92 technique issue")

    if len(df) &gt; 15:
        first =3D df["speed"].iloc[:len(df)//2].mean()
        second =3D df["speed"].iloc[len(df)//2:].mean()
        if second &lt; first:
            feedback.append("=E2=9A=A0=EF=B8=8F Fatigue detected after mid-=
session")

    if not feedback:
        feedback.append("=E2=9C=85 Strong consistent performance")

