def add_features(df: pd.DataFrame) -&gt; pd.DataFrame:
    df =3D df.copy()
    df["power"]      =3D df["speed"] * df["impact"]
    df["efficiency"] =3D df["impact"] / (df["duration"] + 1e-6)
    df["intensity"]  =3D (df["speed"] + df["impact"] + df["power"]) / 3
    df["swing_no"]   =3D range(1, len(df) + 1)
    return df

