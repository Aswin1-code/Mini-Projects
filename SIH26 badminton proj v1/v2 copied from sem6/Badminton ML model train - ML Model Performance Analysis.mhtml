from flask import Flask, request, jsonify
import pandas as pd
import joblib

app =3D Flask(__name__)

# -------------------------------
# LOAD MODEL
# -------------------------------
model_package =3D joblib.load(r"E:\Mini Project\gitfolder all proj\Mini-Pro=
jects\Sem6\ML model PKL\swing_model.pkl")
model =3D model_package["model"]
features =3D model_package["features"]

# -------------------------------
# FEATURE ENGINEERING
# -------------------------------
def add_features(df):
    df["power"] =3D df["speed"] * df["impact"]
    df["efficiency"] =3D df["impact"] / (df["duration"] + 1e-6)
    return df

# -------------------------------
# HOME
# -------------------------------
@app.route("/")
def home():
    return "=F0=9F=8F=B8 Swing ML API Running"

# -------------------------------
# PREDICT SINGLE JSON (ESP32 READY)
# -------------------------------
@app.route("/predict", methods=3D["POST"])
def predict():
    data =3D request.json

    df =3D pd.DataFrame([data])
    df =3D add_features(df)

    prediction =3D model.predict(df[features])[0]

    return jsonify({
        "prediction": prediction
    })

# -------------------------------
# SIMULATION (CSV TEST MODE)
# -------------------------------
@app.route("/simulate", methods=3D["POST"])
def simulate():
    file =3D request.files["file"]

    df =3D pd.read_csv(file)

    # clean
    for col in ["speed", "impact", "duration"]:
        df[col] =3D pd.to_numeric(df[col], errors=3D"coerce")

    df =3D df.dropna()

    # features
    df =3D add_features(df)

    # predict
    df["prediction"] =3D model.predict(df[features])

    # stats
    result =3D {
        "total": len(df),
        "weak": int((df["prediction"] =3D=3D "WEAK").sum()),
        "medium": int((df["prediction"] =3D=3D "MEDIUM").sum()),
        "strong": int((df["prediction"] =3D=3D "STRONG").sum())
    }

    df.to_csv("simulation_output.csv", index=3DFalse)

    return jsonify(result)

# -------------------------------
# RUN
# -------------------------------
if __name__ =3D=3D "__main__":
    app.run(debug=3DTrue)


