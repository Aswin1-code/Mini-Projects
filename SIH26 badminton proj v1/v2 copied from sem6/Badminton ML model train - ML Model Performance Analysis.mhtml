df["duration"] =3D pd.to_numeric(df["duration"], errors=3D"coerce")

df =3D df.dropna()

# -------------------------------
# 3. LABEL CREATION (RULE SYSTEM)
# -------------------------------
def assign_label(speed, impact):
    if speed &gt;=3D 52 or impact &gt;=3D 43:
        return "STRONG"
    elif speed &gt;=3D 43 or impact &gt;=3D 35:
        return "MEDIUM"
    else:
        return "WEAK"

