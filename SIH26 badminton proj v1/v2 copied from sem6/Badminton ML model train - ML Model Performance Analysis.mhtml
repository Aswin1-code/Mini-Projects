def coach_report(df: pd.DataFrame) -&gt; dict:
    r  =3D {}
    pm =3D df["power"].mean();     ps =3D df["power"].std()
    em =3D df["efficiency"].mean(); sm =3D df["speed"].mean()
    n  =3D len(df)

    cv              =3D ps / (pm + 1e-6)
    r["consistency"] =3D round(max(0, min(100, 100 - cv * 100)), 1)

    if   r["consistency"] &gt;=3D 80 and em &gt;=3D 70: r["grade"] =3D ("S"=
, "#00C853", "Elite")
    elif r["consistency"] &gt;=3D 65 and em &gt;=3D 55: r["grade"] =3D ("A"=
, "#00D4FF", "Advanced")
    elif r["consistency"] &gt;=3D 50 and em &gt;=3D 40: r["grade"] =3D ("B"=
, "#FFD700", "Intermediate")
    else:                                      r["grade"] =3D ("C", "#FF4B4=
B", "Needs Work")

    r["power_mean"]  =3D round(pm, 2); r["eff_mean"]  =3D round(em, 2)
    r["speed_mean"]  =3D round(sm, 2); r["n_swings"]  =3D n

    cnt =3D df["prediction"].value_counts()
    r["strong_pct"] =3D round(cnt.get("STRONG", 0) / n * 100, 1)
    r["medium_pct"] =3D round(cnt.get("MEDIUM", 0) / n * 100, 1)
    r["weak_pct"]   =3D round(cnt.get("WEAK",   0) / n * 100, 1)

    r["best_swing"]  =3D df.loc[df["power"].idxmax()]
    r["worst_swing"] =3D df.loc[df["power"].idxmin()]

    if n &gt;=3D 6:
        mid =3D n // 2
        f1  =3D df["speed"].iloc[:mid].mean(); f2 =3D df["speed"].iloc[mid:=
].mean()
        drop =3D (f1 - f2) / (f1 + 1e-6) * 100
        r["fatigue_drop"]     =3D round(drop, 1)
        r["fatigue_detected"] =3D drop &gt; 8
    else:
        r["fatigue_drop"] =3D 0; r["fatigue_detected"] =3D False

    r["tech_mismatch"]  =3D (sm &gt; 45 and em &lt; 60)
    r["power_unstable"] =3D (cv &gt; 0.4)

    if n &gt;=3D 5:
        roll  =3D df["power"].rolling(3, min_periods=3D1).mean()
        slope =3D np.polyfit(range(len(roll)), roll, 1)[0]
        r["trend"] =3D "=F0=9F=93=88 Improving" if slope &gt; 0.3 else ("=
=F0=9F=93=89 Declining" if slope &lt; -0.3 else "=E2=9E=A1=EF=B8=8F Stable"=
)
    else:
        r["trend"] =3D "=E2=9E=A1=EF=B8=8F Stable"

    ins =3D []
    if r["power_unstable"]:
        ins.append(("warn","=E2=9A=A1 Power Inconsistency",
            "Swing power varies too much. Work on consistent grip tension a=
nd follow-through."))
    else:
        ins.append(("good","=E2=9A=A1 Power Stability",
            "Power output is stable =E2=80=94 great muscular control throug=
hout session."))

    if em &lt; 40:
        ins.append(("bad","=F0=9F=8E=AF Critical Efficiency",
            "Efficiency critically low. Fix contact timing and reduce waste=
d arm motion."))
    elif em &lt; 60:
        ins.append(("warn","=F0=9F=8E=AF Efficiency Below Target",
            "Efficiency needs work =E2=80=94 check racket face angle and wr=
ist snap at contact."))
    else:
        ins.append(("good","=F0=9F=8E=AF Efficiency Optimal",
            "Good impact-to-duration ratio. Technique is converting speed t=
o power well."))

    if r["tech_mismatch"]:
        ins.append(("warn","=E2=9A=A0=EF=B8=8F Speed-Impact Mismatch",
            "High swing speed not converting to impact. Adjust contact poin=
t timing."))

    if r["fatigue_detected"]:
        ins.append(("bad", f"=F0=9F=94=BB Fatigue Detected ({r['fatigue_dro=
p']}% drop)",
            "Performance declined in second half. Add stamina drills and re=
st intervals."))
    else:
        ins.append(("good","=F0=9F=94=A5 No Fatigue Detected",
            "Speed maintained throughout =E2=80=94 excellent physical condi=
tioning."))

    if r["consistency"] &lt; 60:
        ins.append(("warn", f"=F0=9F=93=89 Consistency: {r['consistency']}%=
",
            "High swing variation. Drill repeatable swing mechanics and foo=
twork patterns."))
    else:
        ins.append(("good", f"=F0=9F=8F=86 Consistency: {r['consistency']}%=
",
            "Low swing variation =E2=80=94 muscle memory is well-developed.=
"))

    r["insights"] =3D ins
    r["recommendations"] =3D [
        "=F0=9F=8F=81 Prioritise timing over raw speed",
        "=F0=9F=8E=AF Record and compare swing-by-swing metrics weekly",
        "=F0=9F=92=AA Add plyometric drills to boost explosive power",
        "=F0=9F=A7=98 Cool-down stretches to reduce next-session fatigue",
    ]
    return r

