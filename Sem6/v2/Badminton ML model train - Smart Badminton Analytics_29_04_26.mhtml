MPU6050 mpu;

// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
// SIMPLE FAST DASHBOARD VERSION
// Minimal UI + Live Data + CSV Download
// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D

// ---------------- WiFi AP ----------------
const char* ssid =3D "ESP32_Swing";
const char* password =3D "12345678";

WebServer server(80);

// ---------------- Sensor Offsets ----------------
float axOffset =3D 0;
float ayOffset =3D 0;
float azOffset =3D 0;

float gxOffset =3D 0;
float gyOffset =3D 0;
float gzOffset =3D 0;

// ---------------- Gravity Filter ----------------
float gravity =3D 0;
float alpha =3D 0.95;

// ---------------- Kalman Filter ----------------
class Kalman {
  float Q, R, P, X;

public:
  Kalman(float q, float r, float x0) {
    Q =3D q;
    R =3D r;
    P =3D 1;
    X =3D x0;
  }

  float update(float measurement) {
    P =3D P + Q;
    float K =3D P / (P + R);
    X =3D X + K * (measurement - X);
    P =3D (1 - K) * P;
    return X;
  }
};

// Kalman filters
Kalman kAx(0.001, 0.1, 0);
Kalman kAy(0.001, 0.1, 0);
Kalman kAz(0.001, 0.1, 0);

Kalman kGx(0.001, 0.1, 0);
Kalman kGy(0.001, 0.1, 0);
Kalman kGz(0.001, 0.1, 0);

// ---------------- Swing Variables ----------------
bool swingStarted =3D false;

float peakSpeed =3D 0;
float maxImpact =3D 0;
float swingDuration =3D 0;

unsigned long swingStartTime =3D 0;

// thresholds
float START_THRESHOLD =3D 15.0;
float END_THRESHOLD   =3D 7.0;
float MIN_DURATION    =3D 0.20;

// ---------------- Live Data ----------------
float live_ax =3D 0;
float live_ay =3D 0;
float live_az =3D 0;

float live_gx =3D 0;
float live_gy =3D 0;
float live_gz =3D 0;

float live_speed =3D 0;
float live_impact =3D 0;
float live_duration =3D 0;

unsigned long live_time =3D 0;

// ---------------- CSV Storage ----------------
String csvData =3D
"timestamp,ax,ay,az,gx,gy,gz,speed,impact,duration\n";

// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
// SUPER SIMPLE HTML UI
