// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
// WEB HANDLERS
// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
void handleRoot() {
  server.send(200, "text/html", htmlPage);
}

void handleData() {
  String json =3D "{";

  json +=3D "\"time\":" + String(live_time) + ",";
  json +=3D "\"ax\":" + String(live_ax) + ",";
  json +=3D "\"ay\":" + String(live_ay) + ",";
  json +=3D "\"az\":" + String(live_az) + ",";

  json +=3D "\"gx\":" + String(live_gx) + ",";
  json +=3D "\"gy\":" + String(live_gy) + ",";
  json +=3D "\"gz\":" + String(live_gz) + ",";

  json +=3D "\"speed\":" + String(live_speed) + ",";
  json +=3D "\"impact\":" + String(live_impact) + ",";
  json +=3D "\"duration\":" + String(live_duration);

  json +=3D "}";

  server.send(200, "application/json", json);
}

void handleDownload() {
  server.sendHeader(
    "Content-Disposition",
    "attachment; filename=3Dbadminton_data.csv"
  );

  server.send(200, "text/csv", csvData);
}

// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
// SETUP
// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
void setup() {
  Serial.begin(115200);
  Wire.begin(26, 25);

  Serial.println("Initializing MPU6050...");

  mpu.initialize();

  if (!mpu.testConnection()) {
    Serial.println("MPU6050 connection failed!");
    while (1);
  }

  // ---------------- Calibration ----------------
  Serial.println("Keep racket still for 3 seconds...");

  long axSum =3D 0, aySum =3D 0, azSum =3D 0;
  long gxSum =3D 0, gySum =3D 0, gzSum =3D 0;

  int samples =3D 0;
  unsigned long start =3D millis();

  while (millis() - start &lt; 3000) {
    int16_t ax, ay, az, gx, gy, gz;

    mpu.getMotion6(&amp;ax, &amp;ay, &amp;az, &amp;gx, &amp;gy, &amp;gz);

    axSum +=3D ax;
    aySum +=3D ay;
    azSum +=3D az;

    gxSum +=3D gx;
    gySum +=3D gy;
    gzSum +=3D gz;

    samples++;
    delay(2);
  }

  axOffset =3D axSum / (float)samples;
  ayOffset =3D aySum / (float)samples;
  azOffset =3D azSum / (float)samples;

  gxOffset =3D gxSum / (float)samples;
  gyOffset =3D gySum / (float)samples;
  gzOffset =3D gzSum / (float)samples;

  Serial.println("Calibration Done");

  // ---------------- WiFi AP ----------------
  WiFi.softAP(ssid, password);

  Serial.println("WiFi Started");
  Serial.print("Connect to: ");
  Serial.println(WiFi.softAPIP());

  // ---------------- Web Routes ----------------
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/download", handleDownload);

  server.begin();

  Serial.println(
    "timestamp,ax,ay,az,gx,gy,gz,speed,impact,duration"
  );
}

// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
// LOOP
// =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D
void loop() {
  server.handleClient();

  int16_t ax, ay, az, gx, gy, gz;
  mpu.getMotion6(&amp;ax, &amp;ay, &amp;az, &amp;gx, &amp;gy, &amp;gz);

  // ---------------- Raw =E2=86=92 Physical ----------------
  float Ax =3D (ax - axOffset) / 16384.0;
  float Ay =3D (ay - ayOffset) / 16384.0;
  float Az =3D (az - azOffset) / 16384.0;

  float Gx =3D (gx - gxOffset) / 131.0;
  float Gy =3D (gy - gyOffset) / 131.0;
  float Gz =3D (gz - gzOffset) / 131.0;

  // ---------------- Kalman Filter ----------------
  float Ax_f =3D kAx.update(Ax);
  float Ay_f =3D kAy.update(Ay);
  float Az_f =3D kAz.update(Az);

  float Gx_f =3D kGx.update(Gx);
  float Gy_f =3D kGy.update(Gy);
  float Gz_f =3D kGz.update(Gz);

  // ---------------- Gravity Removal ----------------
  gravity =3D alpha * gravity + (1 - alpha) * Az_f;

  float linAccX =3D Ax_f * 9.81;
  float linAccY =3D Ay_f * 9.81;
  float linAccZ =3D (Az_f - gravity) * 9.81;

  float totalAcc =3D sqrt(
    linAccX * linAccX +
    linAccY * linAccY +
    linAccZ * linAccZ
  );

  float angularVelocity =3D sqrt(
    Gx_f * Gx_f +
    Gy_f * Gy_f +
    Gz_f * Gz_f
  );

  // estimated speed
  float instantSpeed =3D angularVelocity * 0.12;

  unsigned long now =3D millis();

  // =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D
  // START SWING
  // =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D
  if (!swingStarted &amp;&amp; totalAcc &gt; START_THRESHOLD) {
    swingStarted =3D true;

    swingStartTime =3D now;
    peakSpeed =3D instantSpeed;
    maxImpact =3D totalAcc;
  }

  // =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D
  // DURING SWING
